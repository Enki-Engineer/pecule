{
  "name": "pecule",
  "private": true,
  "version": "1.21.0",
  "type": "module",
  "description": "Suivi des finances d'un foyer, auto-hébergé : comptes, opérations, patrimoine, factures, documents.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "tsx scripts/check-schema.ts",
    "i18n:manquants": "tsx scripts/i18n-manquants.ts",
    "db:generate": "drizzle-kit generate",
    "db:initial": "tsx scripts/schema-initial.ts",
    "sauvegarde": "tsx scripts/sauvegarde.ts",
    "restaurer": "tsx scripts/restaurer.ts",
    "local": "tsx scripts/local.ts",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "importer": "node scripts/importer.mjs",
    "garde-fou": "node scripts/garde-fou.mjs"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^1.1.1",
    "@anthropic-ai/sdk": "^1.7.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "lucide-react": "^1.71.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.1.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "drizzle-kit": "0.31.11",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0-only"
}
